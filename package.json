{
  "name": "signal-school",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser && npm run realtime:build && npm run build",
    "realtime:dev": "tsx realtime/src/server.ts",
    "realtime:build": "tsc -p realtime/tsconfig.json",
    "realtime:test": "vitest run realtime/tests"
  },
  "dependencies": {
    "@fontsource/chivo": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "better-sqlite3": "^12.6.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.5.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.16"
  }
}
